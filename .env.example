NEXT_PUBLIC_LIVE_URL=localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never NEXT_PUBLIC_): the pipeline routes write interview records with it.
SUPABASE_SERVICE_ROLE_KEY=

# mock (default: in-memory, lost on restart) | supabase (response table; needs the keys above)
PIPELINE_STORAGE=mock

# Retell AI
RETELL_API_KEY=

# Gemini
GEMINI_API_KEY=

# mock | groq | gemini (required by src/lib/llm.ts)
LLM_MODE=mock

# Groq (LLM_MODE=groq)
GROQ_API_KEY=

# Recruiter sign-in passcode for /admin (required in production; dev falls back to "recruiter")
ADMIN_PASSCODE=
